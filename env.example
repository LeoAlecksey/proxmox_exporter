# .env — скопировать в папку с бинарником, подставить данные.

# Формат каждого кластера:
#   метка | host:port | user@realm!tokenid | uuid-токена
#
# Как создать токен в Proxmox:
#   Datacenter → Permissions → API Tokens → Add
#   User: monitoring@pve  Token ID: prom  Privilege Separation: No
#   Roles: Datastore.Audit, Sys.Audit, SDN.Audit, VM.Audit (актуально для ProxMox VE 9)
#
# Если несколько кластеров, перечислить данные, прим:
# PROXMOX_CLUSTERS="prod|192.168.1.10:8006|monitoring@pve!prom|xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx,staging|192.168.2.10:8006|monitoring@pve!prom|yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy"
#
# Порт HTTP сервера для Prometheus
#EXPORTER_PORT=9221
#
# Интервал сбора метрик (секунды)
#SCRAPE_INTERVAL=30
#
# Уровень логов: trace / debug / info / warn / error
#RUST_LOG=info
